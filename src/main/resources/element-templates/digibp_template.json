[
   {
      "$schema":"https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
      "name":"API Connect",
      "id":"onl.mrtn.camunda.http.api_connect",
      "description":"Connect to a REST API.",
      "version":2,
      "entriesVisible":false,
      "appliesTo":[
         "bpmn:Task",
         "bpmn:ServiceTask",
         "bpmn:SendTask"
      ],
      "elementType":{
         "value":"bpmn:ServiceTask"
      },
      "groups":[
         {
            "id":"endpoint",
            "label":"Endpoint"
         },
         {
            "id":"authentication",
            "label":"Authentication"
         },
         {
            "id":"mapping",
            "label":"Mapping"
         }
      ],
      "properties":[
         {
            "type":"Hidden",
            "value":"${api_connect}",
            "binding":{
               "type":"property",
               "name":"camunda:delegateExpression"
            }
         },
         {
            "label":"🔗 URL",
            "group":"endpoint",
            "type":"String",
            "binding":{
               "type":"camunda:field",
               "name":"api_connect_url"
            },
            "constraints":{
               "notEmpty":true,
               "pattern":{
                  "value":"^(=|http://|https://|secrets).*$",
                  "message":"Must be a http(s) URL."
               }
            }
         },
         {
            "label":"🔑 Authorization Header",
            "description":"Here it would be possible to define an authorisation header string if necessary, for example to specify a bearer token. Otherwise, indicate “None”.",
            "group":"authentication",
            "type":"String",
            "value":"None",
            "binding":{
               "type":"camunda:field",
               "name":"api_connect_authorization"
            },
            "constraints":{
               "notEmpty":true
            },
            "optional":true
         },
         {
            "label":"🪄 Automatic ➡️ Outgoing Variables",
            "description":"Shall workflow variables automatically be transferred to the endpoint?",
            "group":"mapping",
            "type":"Dropdown",
            "value":"true",
            "binding":{
               "type":"camunda:field",
               "name":"api_connect_api_variables"
            },
            "choices":[
               {
                  "name":"Yes",
                  "value":"true"
               },
               {
                  "name":"No",
                  "value":"false"
               }
            ]
         },
         {
            "label":"🪄 Automatic ⬅️ Incoming Variables",
            "description":"Shall workflow variables automatically be created based on the response JSON object?",
            "group":"mapping",
            "type":"Dropdown",
            "value":"true",
            "binding":{
               "type":"camunda:field",
               "name":"api_connect_result_variables"
            },
            "choices":[
               {
                  "name":"Yes",
                  "value":"true"
               },
               {
                  "name":"No",
                  "value":"false"
               }
            ]
         },
         {
            "label":"🟰 Result Variable",
            "description":"A global variable can be defined here to extract data from the JSON object later. Otherwise, indicate “None”.",
            "group":"mapping",
            "type":"String",
            "value":"None",
            "binding":{
               "type":"camunda:field",
               "name":"api_connect_result_variable"
            },
            "constraints":{
               "notEmpty":true
            },
            "optional":true
         },
         {
            "label":"🗣️ Verbosity",
            "description":"Verbosity of the data object?",
            "group":"mapping",
            "type":"Dropdown",
            "value":"plain",
            "binding":{
               "type":"camunda:field",
               "name":"api_connect_verbosity_outgoing"
            },
            "choices":[
               {
                  "name":"Plain JSON object",
                  "value":"plain"
               },
               {
                  "name":"JSON object with business key",
                  "value":"businessKey"
               },
               {
                  "name":"Extended JSON object",
                  "value":"extended"
               }
            ]
         },
         {
            "label":"➡️ Outgoing Variables",
            "description":"By default, all workflow variables are transferred to the endpoint. If only selected workflow variables are to be transferred, they must be listed using “Assignment type” as “List” with the variable name.",
            "binding":{
               "type":"camunda:inputParameter",
               "name":"api_connect_api_variables"
            },
            "optional":true
         },
         {
            "label":"⬅️ Incoming Variables",
            "description":"By default, workflow variables are automatically created based on the response JSON object. If only selected workflow variables should be created, they must be listed using “Assignment type” as “List” with the variable name.",
            "binding":{
               "type":"camunda:inputParameter",
               "name":"api_connect_result_variables"
            },
            "optional":true
         }
      ]
   },
   {
      "$schema":"https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
      "name":"Notify Task",
      "id":"onl.mrtn.camunda.http.notify.task",
      "description":"Notify a REST API.",
      "version":1,
      "entriesVisible":false,
      "appliesTo":[
         "bpmn:Task",
         "bpmn:SendTask"
      ],
      "elementType":{
         "value":"bpmn:SendTask"
      },
      "groups":[
         {
            "id":"endpoint",
            "label":"Endpoint"
         }
      ],
      "properties":[
         {
            "type":"Hidden",
            "value":"${notify}",
            "binding":{
               "type":"property",
               "name":"camunda:delegateExpression"
            }
         },
         {
            "label":"🔗 URL",
            "group":"endpoint",
            "type":"String",
            "binding":{
               "type":"camunda:field",
               "name":"notify_url"
            },
            "constraints":{
               "notEmpty":true,
               "pattern":{
                  "value":"^(=|http://|https://|secrets).*$",
                  "message":"Must be a http(s) URL."
               }
            }
         }
      ]
   },
   {
      "$schema":"https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
      "name":"Notify Extension External Task",
      "id":"onl.mrtn.camunda.http.notify.external",
      "description":"Notify a REST API prior external task client.",
      "version":1,
      "entriesVisible":false,
      "appliesTo":[
         "bpmn:Task",
         "bpmn:ServiceTask"
      ],
      "elementType":{
         "value":"bpmn:ServiceTask"
      },
      "groups":[
         {
            "id":"endpoint",
            "label":"Endpoint"
         },
         {
            "id":"external",
            "label":"External Task"
         }
      ],
      "properties":[
         {
            "binding":{
               "name":"camunda:type",
               "type":"property"
            },
            "type":"Hidden",
            "value":"external"
         },
         {
            "binding":{
               "name":"camunda:topic",
               "type":"property"
            },
            "label":"External Task Topic",
            "group":"external",
            "type":"String",
            "constraints":{
               "notEmpty":true
            }
         },
         {
            "label":"🔗 URL",
            "group":"endpoint",
            "type":"String",
            "binding":{
               "type":"camunda:property",
               "name":"notify_url"
            },
            "constraints":{
               "notEmpty":true,
               "pattern":{
                  "value":"^(=|http://|https://|secrets).*$",
                  "message":"Must be a http(s) URL."
               }
            }
         }
      ]
   },
   {
      "$schema":"https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
      "name":"External Task",
      "id":"onl.mrtn.camunda.external",
      "description":"External task client.",
      "version":1,
      "entriesVisible":false,
      "appliesTo":[
         "bpmn:Task",
         "bpmn:ServiceTask"
      ],
      "elementType":{
         "value":"bpmn:ServiceTask"
      },
      "groups":[
         {
            "id":"external",
            "label":"External Task"
         }
      ],
      "properties":[
         {
            "binding":{
               "name":"camunda:type",
               "type":"property"
            },
            "type":"Hidden",
            "value":"external"
         },
         {
            "binding":{
               "name":"camunda:topic",
               "type":"property"
            },
            "label":"External Task Topic",
            "group":"external",
            "type":"String",
            "constraints":{
               "notEmpty":true
            }
         }
      ]
   },
   {
      "$schema":"https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
      "name":"Inter Process Message Extension",
      "id":"onl.mrtn.camunda.interprocess",
      "description":"Message another process.",
      "version":1,
      "entriesVisible":false,
      "appliesTo":[
         "bpmn:Task",
         "bpmn:ServiceTask"
      ],
      "elementType":{
         "value":"bpmn:SendTask"
      },
      "groups":[
         {
            "id":"message",
            "label":"Message"
         }
      ],
      "properties":[
         {
            "type":"Hidden",
            "value":"${inter_process}",
            "binding":{
               "type":"property",
               "name":"camunda:delegateExpression"
            }
         },
         {
            "label":"📮 Message Name",
            "group":"message",
            "type":"String",
            "binding":{
               "type":"camunda:field",
               "name":"message_name"
            },
            "constraints":{
               "notEmpty":true
            }
         }
      ]
   },
   {
      "$schema": "https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
      "name": "JSON HTTP Request + JSONPath Extraction",
      "id": "onl.mrtn.camunda.http.json_api_call",
      "description": "Send an HTTP request with an optional JSON body and optional Bearer authentication. Store the HTTP status and complete response body, and optionally extract a value, object, or array using JSONPath. Includes a zero-shot decision model sentiment example.",
      "version": 4,
      "entriesVisible": false,
      "appliesTo": [
         "bpmn:ServiceTask"
      ],
      "groups": [
         {
            "id": "endpoint",
            "label": "Endpoint"
         },
         {
            "id": "request",
            "label": "Request"
         },
         {
            "id": "response",
            "label": "Response"
         }
      ],
      "properties": [
         {
            "label": "Authentication",
            "description": "Choose no authentication, your own key, or the server key. Key modes require HTTPS. The server key is sent only to OPENAI_BASE_URL and endpoints below its path.",
            "type": "Dropdown",
            "value": "server-openai",
            "choices": [
               {
                  "name": "None",
                  "value": "none"
               },
               {
                  "name": "Own key",
                  "value": "own-key"
               },
               {
                  "name": "Server key (OPENAI_API_KEY)",
                  "value": "server-openai"
               }
            ],
            "binding": {
               "type": "camunda:inputParameter",
               "name": "jsonApiAuthType"
            }
         },
         {
            "label": "Auth Key (Own key)",
            "description": "Used only with Own key. Paste the key without the Bearer prefix. This value is saved in the BPMN model; leave empty for None or Server key.",
            "type": "String",
            "value": "",
            "binding": {
               "type": "camunda:property",
               "name": "digibpAuthKey"
            }
         },
         {
            "label": "Response JSONPath",
            "description": "Select one value, object or array from the response. Use $ for the complete JSON response. Leave empty to disable extraction.",
            "group": "response",
            "type": "String",
            "value": "$.answers.is_positive.noul",
            "binding": {
               "type": "camunda:inputParameter",
               "name": "jsonApiResponsePath"
            }
         },
         {
            "label": "Result Format",
            "description": "Scalar value returns a number, string, boolean or null. JSON text returns serialized JSON, including objects and arrays.",
            "group": "response",
            "type": "Dropdown",
            "value": "scalar",
            "choices": [
               {
                  "name": "Scalar value",
                  "value": "scalar"
               },
               {
                  "name": "JSON text",
                  "value": "json"
               }
            ],
            "binding": {
               "type": "camunda:inputParameter",
               "name": "jsonApiResultFormat"
            }
         }
      ],
      "scopes": [
         {
            "type": "camunda:Connector",
            "properties": [
               {
                  "type": "Hidden",
                  "value": "http-connector",
                  "binding": {
                     "type": "property",
                     "name": "connectorId"
                  }
               },
               {
                  "label": "URL",
                  "description": "Full API endpoint URL. Both key modes require HTTPS. Server key requires the OPENAI_BASE_URL prefix. Redirects are not followed.",
                  "group": "endpoint",
                  "type": "String",
                  "value": "https://litellm.engines.aisl.science/v1/systemone",
                  "constraints": {
                     "notEmpty": true
                  },
                  "binding": {
                     "type": "camunda:inputParameter",
                     "name": "url"
                  }
               },
               {
                  "label": "HTTP Method",
                  "group": "endpoint",
                  "type": "Dropdown",
                  "value": "POST",
                  "choices": [
                     {
                        "name": "GET",
                        "value": "GET"
                     },
                     {
                        "name": "POST",
                        "value": "POST"
                     },
                     {
                        "name": "PUT",
                        "value": "PUT"
                     },
                     {
                        "name": "PATCH",
                        "value": "PATCH"
                     },
                     {
                        "name": "DELETE",
                        "value": "DELETE"
                     }
                  ],
                  "binding": {
                     "type": "camunda:inputParameter",
                     "name": "method"
                  }
               },
               {
                  "label": "Request Body",
                  "description": "JSON text or an expression returning JSON text. Leave empty for requests without a body. The example asks whether customer feedback expresses positive sentiment.",
                  "group": "request",
                  "type": "Text",
                  "value": "{\n  \"model\": \"tev1:0.8b\",\n  \"state\": \"The support team solved my problem quickly. I am very happy with the service.\",\n  \"questions\": {\n    \"is_positive\": {\n      \"type\": \"noul\",\n      \"instructions\": \"Does the customer feedback express positive sentiment?\",\n      \"criteria\": {\n        \"true\": \"The feedback expresses satisfaction, appreciation, or a positive experience.\",\n        \"false\": \"The feedback is neutral or expresses dissatisfaction, criticism, or a negative experience.\"\n      }\n    }\n  }\n}",
                  "binding": {
                     "type": "camunda:inputParameter",
                     "name": "payload"
                  }
               },
               {
                  "type": "Hidden",
                  "value": "${jsonApiAuthType}",
                  "binding": {
                     "type": "camunda:inputParameter",
                     "name": "digibpAuthMode"
                  }
               },
               {
                  "type": "Hidden",
                  "value": "${S('{}').prop('Content-Type', 'application/json').prop('Accept', 'application/json').mapTo('java.util.HashMap')}",
                  "binding": {
                     "type": "camunda:inputParameter",
                     "name": "headers"
                  }
               },
               {
                  "label": "HTTP Status Variable",
                  "description": "Process variable receiving the HTTP status code.",
                  "group": "response",
                  "type": "String",
                  "value": "httpStatus",
                  "constraints": {
                     "notEmpty": true
                  },
                  "binding": {
                     "type": "camunda:outputParameter",
                     "source": "${statusCode}"
                  }
               },
               {
                  "label": "Response Body Variable",
                  "description": "Process variable receiving the complete response body as text.",
                  "group": "response",
                  "type": "String",
                  "value": "apiResponse",
                  "constraints": {
                     "notEmpty": true
                  },
                  "binding": {
                     "type": "camunda:outputParameter",
                     "source": "${response}"
                  }
               },
               {
                  "label": "Extracted Value Variable",
                  "description": "Process variable receiving the selected value or JSON text. Set to null when extraction is disabled or the HTTP status is not 2xx.",
                  "group": "response",
                  "type": "String",
                  "value": "extractedValue",
                  "constraints": {
                     "notEmpty": true
                  },
                  "binding": {
                     "type": "camunda:outputParameter",
                     "source": "${statusCode >= 200 && statusCode < 300 && !empty jsonApiResponsePath ? (jsonApiResultFormat == 'json' ? S(response).jsonPath(jsonApiResponsePath).element().toString() : S(response).jsonPath(jsonApiResponsePath).element().value()) : null}"
                  }
               }
            ]
         }
      ]
   }
]
